# Oykos Newsletter Engine - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL=sqlite+aiosqlite:///oykos.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/oykos

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
# For OpenAI-compatible providers, override the base URL:
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TRIAGE_MODEL=gpt-4o-mini

# ── Gmail SMTP ────────────────────────────────────────────
# Generate an app password at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SENDER_EMAIL=your-email@gmail.com

# ── Newsletter ────────────────────────────────────────────
NEWSLETTER_TITLE=L'Essenziale in Pediatria
MAX_NEWSLETTER_ITEMS=12
ITALY_RATIO=0.7

# ── Subscriber Management ────────────────────────────────
# Base URL for confirmation/unsubscribe links (no trailing slash)
BASE_URL=http://localhost:8000

# ── Healthcheck ───────────────────────────────────────────
# Ping URL called on successful pipeline run (e.g. https://hc-ping.com/your-uuid)
HEALTHCHECK_PING_URL=

# ── A/B Testing ───────────────────────────────────────────
# Percentage of subscribers to receive variant B subject line (0-50)
AB_TEST_PERCENT=10

# ── App ───────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to "true" to require manual approval before sending
PREVIEW_MODE=false
