# Oykos Newsletter Engine - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL=sqlite+aiosqlite:///oykos.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/oykos

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
# For OpenAI-compatible providers, override the base URL:
# OPENAI_BASE_URL=https://api.openai.com/v1
# Primary model for editorial synthesis, triage model for classification.
# Editorial copy is only written for items that survive ranking, so most spend
# sits in OPENAI_TRIAGE_MODEL. Subject lines, preheader and the A/B variants use
# the primary model: it is one call per issue, and a variant that is only a
# paraphrase makes the whole comparison worthless.
# Both accept any model your provider exposes - swap them to cut cost.
OPENAI_MODEL=gpt-5.4
OPENAI_TRIAGE_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=3

# ── SMTP delivery (Zoho Mail) ─────────────────────────────
# The host MUST match the Zoho data centre your account lives in. Check the URL
# you log in to: mail.zoho.eu -> smtp.zoho.eu, mail.zoho.com -> smtp.zoho.com
#   smtp.zoho.com      United States
#   smtp.zoho.eu       Europe
#   smtp.zoho.in       India
#   smtp.zoho.com.au   Australia
#   smtp.zoho.jp       Japan
#   smtp.zohocloud.ca  Canada
SMTP_HOST=smtp.zoho.eu
# 465 = implicit SSL (SMTP_USE_SSL=true), 587 = STARTTLS (SMTP_USE_SSL=false)
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=you@yourdomain.it
# With two-factor auth enabled, this must be an app-specific password:
# Zoho Mail > My Account > Security > App passwords
SMTP_PASSWORD=your-zoho-app-password
# Must be an address the Zoho account is allowed to send as: the mailbox itself,
# a verified alias, or an address on a verified domain.
SENDER_EMAIL=you@yourdomain.it
# Optional mailto: fallback for List-Unsubscribe (see docs/deliverability.md)
UNSUBSCRIBE_MAILTO=

# Pacing, to stay inside Zoho's per-connection and per-hour limits.
SMTP_THROTTLE_SECONDS=1.0
SMTP_MAX_PER_CONNECTION=50

# Verify the connection without sending:  oykos check-smtp

# ── Newsletter ────────────────────────────────────────────
NEWSLETTER_TITLE=L'Essenziale in Pediatria
# 5 slots split 70/30 Italy/foreign. A PLS reads this between patients, so the
# ranker also caps any single source at 2 slots.
MAX_NEWSLETTER_ITEMS=5
ITALY_RATIO=0.7
MIN_READING_MINUTES=3
MAX_READING_MINUTES=5

# ── Trigger alerts ────────────────────────────────────────
# Hard events only, capped per rolling 30 days. Do not raise this casually:
# over-notification is the fastest way to lose this audience.
MAX_ALERTS_PER_MONTH=2

# ── Editorial review ─────────────────────────────────────
# Shared secret for /review. Leave EMPTY to disable the review interface
# entirely (it fails closed). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REVIEW_TOKEN=
REVIEW_SESSION_HOURS=12
# Hours to wait for a human before shipping only the cleared items.
# 0 (default) means an issue waits indefinitely, which is the safe choice for
# medical content.
AUTO_SEND_AFTER_HOURS=0

# ── Subscriber Management ────────────────────────────────
# Base URL for confirmation/unsubscribe links (no trailing slash)
BASE_URL=http://localhost:8000

# ── Measurement and A/B testing ──────────────────────────
# Click tracking rewrites every outbound link through /r/<token> so the engine
# can count unique clicks, source clicks and return in the following weeks.
#
# PRIVACY: a click record ties a named subscriber to what they chose to read.
# That is personal data. Do NOT switch this on until the privacy notice says
# you measure clicks. Erasure deletes click history along with the subscriber.
#
# There is deliberately no open-rate tracking pixel: Apple Mail Privacy
# Protection pre-fetches images, so an open rate measures the mail client
# rather than the reader.
CLICK_TRACKING=false
# Signs the redirect tokens. Without it, /r/ would be an open redirect that
# anyone could use for phishing under your domain, so tracking stays off
# unless this is set. Use a DIFFERENT value from REVIEW_TOKEN:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRACKING_SECRET=

# Change ONE element at a time, or the result tells you nothing about which
# change moved the number. One of: none | subject | preheader | cta
AB_ELEMENT=none

# ── WordPress publishing (oykomed.it) ─────────────────────
# Each issue is posted to WordPress before the email goes out, so the email can
# carry a working "Leggi online" link. Leave WORDPRESS_URL empty to disable.
# Site root, no trailing slash and no /wp-json suffix:
WORDPRESS_URL=
WORDPRESS_USER=
# This is an Application Password, NOT your WordPress account password.
# Generate it at: WordPress admin > Users > Profile > Application Passwords
# (requires WordPress 5.6+ and HTTPS). Spaces in the generated value are fine.
WORDPRESS_APP_PASSWORD=
# "publish" posts live immediately, "draft" stages it for a human to publish.
WORDPRESS_STATUS=publish
# Optional category ID to file issues under. 0 = site default.
WORDPRESS_CATEGORY_ID=0

# ── Closing call to action ────────────────────────────────
# Every issue ends with a CTA linking to the Oykos landing page.
CTA_URL=https://oykomed.it

# Masthead logo shown at the top of every issue and in the footer.
# The default points at oykomed.it, whose filename carries a build hash and
# WILL stop resolving when that site is redeployed. Host a copy at a stable
# URL (any public HTTPS path works) and point this at it.
LOGO_URL=https://oykomed.it/_next/static/media/logo-sm.abbdf224.png

# ── Healthcheck ───────────────────────────────────────────
# Ping URL called on successful pipeline run (e.g. https://hc-ping.com/your-uuid)
HEALTHCHECK_PING_URL=

# ── App ───────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to "true" to require manual approval before sending
PREVIEW_MODE=false
